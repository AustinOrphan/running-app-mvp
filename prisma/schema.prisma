// Enum-like columns are plain strings; zod validates them at the API edge and
// shared/types.ts narrows them to unions. Dates are YYYY-MM-DD strings.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  units        String   @default("mi") // 'mi' | 'km'
  weightUnit   String   @default("lb") // 'lb' | 'kg'; strength loads are shown in it (the migration sets 'kg' where units = 'km')
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities        Activity[]
  importBatches     ImportBatch[]
  goals             Goal[]
  plans             Plan[]
  reviews           WeeklyReview[]
  profile           AthleteProfile?
  wellnessDays      WellnessDay[]
  integrations      Integration[]
  importedFiles     ImportedFile[]
  predictions       PredictionLog[]
  screenings        Screening[]
  syncRuns          SyncRun[]
  deliveryChannels  DeliveryChannel[]
  wristPublications WristPublication[]
  raceResults       RaceResult[]
  fuelProducts      FuelProduct[]
  fuelLogs          FuelLog[]
  fuelSettings      FuelSettings?
  disruptions       Disruption[]
  weeklyBriefs      WeeklyBrief[]
  strengthSettings  StrengthSettings?
  strengthLifts     StrengthLift[]
  strengthLogs      StrengthLog[]
  strengthSets      StrengthSet[]
}

model Activity {
  id              String   @id @default(cuid())
  userId          String
  date            String // YYYY-MM-DD, runner's local day
  startTime       String? // HH:MM
  type            String // 'run' | 'race' | 'strength' | 'cross'
  durationSec     Int
  distanceM       Int?
  rpe             Int?
  avgHr           Int?
  maxHr           Int?
  elevationGainM  Int?
  notes           String?
  source          String   @default("manual") // provider registry key, or 'manual' | 'smashrun' | 'csv' | 'file'
  providerKey     String?
  subtype         String? // run/race: road|trail|track|treadmill; cross: bike|hike|walk|swim|ski|elliptical|other
  startUtc        String? // ISO 8601 with Z
  utcOffsetMin    Int?
  movingSec       Int?
  elevationLossM  Int?
  avgCadence      Int? // steps per minute
  avgPowerW       Int?
  deviceName      String?
  startLat        Float? // rounded to 0.01 degrees
  startLng        Float?
  tempC           Float?
  dewPointC       Float?
  windKph         Float?
  humidityPct     Int?
  weatherSource   String? // 'open-meteo' | 'provider' | 'manual'
  hrHistogram     String? // JSON text: HrHistogram
  decouplingPct   Float?
  gapDistanceM    Int?
  feel            Int? // -2 much easier .. +2 much harder than expected
  pain            Int? // 0-10
  importBatchId   String?
  duplicateOfId   String?
  duplicateStatus String   @default("none") // 'none' | 'possible' | 'confirmed' | 'dismissed'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  duplicateOf Activity?        @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Activity[]       @relation("Duplicates")
  stream      ActivityStream?
  file        ActivityFile?
  insight     ActivityInsight?
  planSession PlanSession?
  raceResult  RaceResult?
  fuelLog     FuelLog?
  strengthLog StrengthLog?

  @@unique([userId, providerKey])
  @@index([userId, date])
  @@index([duplicateOfId])
}

model ImportBatch {
  id               String   @id @default(cuid())
  userId           String
  source           String // provider registry key, or 'smashrun' | 'csv' | 'file'
  fileName         String?
  rowCount         Int
  accepted         Int
  skippedDuplicate Int
  skippedInvalid   Int
  errors           String // JSON text: ImportReportRow[]
  createdAt        DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([userId, createdAt])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  name            String
  priority        String // 'A' | 'B' | 'C'
  status          String   @default("target") // 'target' | 'considering' | 'done' | 'dropped'
  targetDate      String // YYYY-MM-DD
  dateProvisional Boolean  @default(false)
  distanceM       Int?
  location        String?
  successCriteria String?
  notes           String?
  url             String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  gainM           Int? // course ascent, metres
  lossM           Int? // course descent, metres
  surface         String   @default("road") // 'road' | 'trail' | 'track' | 'mixed'
  goalType        String   @default("time") // 'finish' | 'time'; the API defaults to 'finish' above 42.2 km
  targetTimeSec   Int?
  startTime       String? // HH:MM
  raceLat         Float? // rounded to 0.01 degrees
  raceLng         Float?
  supportLevel    String   @default("aided") // 'aided' | 'self'

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans       Plan[]
  predictions PredictionLog[]
  raceResult  RaceResult?

  @@index([userId])
}

model Plan {
  id               String   @id @default(cuid())
  userId           String
  goalId           String
  name             String
  startDate        String // Monday, YYYY-MM-DD
  raceWeekStart    String // Monday, YYYY-MM-DD
  status           String   @default("active") // 'active' | 'archived'
  generatorVersion Int // 1 = shared/domain/plan.ts, 2 = shared/engine
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  paramsVersion    String? // PARAMS_VERSION of the parameter registry at generation
  feasibility      String? // JSON text: Feasibility
  warnings         String   @default("[]") // JSON text: EngineWarning[]
  checklist        String   @default("[]") // JSON text: ChecklistResult[]
  options          String   @default("{}") // JSON text: EngineInput['options']

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  weeks     PlanWeek[]
  sessions  PlanSession[]
  revisions PlanRevision[]

  @@index([userId, status])
}

model PlanWeek {
  id               String   @id @default(cuid())
  planId           String
  weekStart        String // Monday, YYYY-MM-DD
  index            Int
  phase            String // see shared/types.ts Phase
  focus            String?
  baselineRunMin   Int
  targetRunMin     Int
  targetSource     String   @default("baseline") // 'baseline' | 'review' | 'override'
  longRunMin       Int
  day2Min          Int?
  runDays          Int
  strengthSessions Int
  overrideNote     String?
  updatedAt        DateTime @updatedAt
  tid              String? // JSON text: { z1, z2, z3 } targets, percent of running time
  flags            String   @default("[]") // JSON text: string[] (recovery, taper, strength, gut-training, heat-acclimation)
  gainTargetM      Int?
  qualitySessions  Int      @default(0) // the engine's count for the week; a re-plan diffs it
  isRecovery       Boolean  @default(false) // the engine's flag; post-race weeks carry no 'recovery' flag

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekStart])
}

model PlanSession {
  id          String   @id @default(cuid())
  planId      String
  externalId  String // uuid; the identity of a session outside the database (watch events, calendar UIDs, revision diffs), kept by every write that keeps the session
  weekStart   String // Monday, YYYY-MM-DD
  date        String // YYYY-MM-DD
  order       Int
  kind        String // see shared/engine/types.ts SessionKind
  title       String
  durationMin Int
  distanceM   Int?
  gainM       Int?
  structure   String   @default("[]") // JSON text: Step[]
  target      String // JSON text: SessionTarget
  purpose     String
  rules       String   @default("[]") // JSON text: string[] of rule ids
  trimmed     Boolean  @default(false) // derived from rules by isTrimmed() in server/serialize.ts, only there
  flags       String   @default("[]") // JSON text: SessionFlag[]
  status      String   @default("planned") // 'planned' | 'completed' | 'partial' | 'skipped' | 'downgraded' | 'moved'
  activityId  String?  @unique
  linkSource  String? // 'auto' | 'owner'
  execution   String? // JSON text: ExecutionAssessment
  original    String? // JSON text: the prescription before a downgrade or move
  updatedAt   DateTime @updatedAt

  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([planId, externalId])
  @@index([planId, date])
  @@index([planId, weekStart, trimmed])
  @@index([planId, status, date])
}

model PlanRevision {
  id           String    @id @default(cuid())
  planId       String
  createdAt    DateTime  @default(now())
  reason       String // 'generate' | 'weekly' | 'review' | 'owner' | 'break' | 'disruption' | 'undo' | 'goal-switch'
  summary      String
  changes      String    @default("[]") // JSON text: PlanChange[]
  auto         Boolean   @default(false) // written by the scheduler, not by a request
  decision     String? // JSON text: the WeeklyDecision this revision acted on (weekly and review)
  diff         String? // JSON text: PlanDiff; null on rows written before the revision model
  undo         String? // JSON text: UndoPayload; never sent to the client; null when nothing can be restored
  undoneAt     DateTime?
  undoneById   String? // the 'undo' revision that reverted this one
  undoOf       String? // on an 'undo' revision: the revision it reverted
  seenAt       DateTime? // the one seen marker in the product
  disruptionId String? // the window this revision created, changed or removed (no foreign key)

  plan  Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  brief WeeklyBrief?

  @@index([planId, createdAt])
  @@index([planId, reason])
}

model PredictionLog {
  id           String   @id @default(cuid())
  userId       String
  goalId       String
  createdAt    DateTime @default(now())
  method       String
  predictedSec Int
  lowSec       Int
  highSec      Int
  inputs       String   @default("{}") // JSON text: today, conditions, rules, paramsVersion, course
  actualSec    Int?
  weekStart    String // Monday of the local week the prediction belongs to, YYYY-MM-DD
  loggedOn     String // runner's local day the prediction was made, YYYY-MM-DD

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, goalId, createdAt])
  @@index([userId, goalId, weekStart])
}

model RaceResult {
  id         String   @id @default(cuid())
  userId     String
  goalId     String   @unique
  activityId String?  @unique
  date       String // YYYY-MM-DD, race day
  distanceM  Int
  gainM      Int?
  outcome    String // 'finished' | 'did-not-finish'
  timeSec    Int? // official finish time; null for a did-not-finish
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
}

model Screening {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  kind      String // 'reds'
  answers   String // JSON text
  flags     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, date])
}

model WeeklyReview {
  id                  String    @id @default(cuid())
  userId              String
  weekStart           String // Monday, YYYY-MM-DD
  dataStatus          String    @default("unconfirmed") // 'unconfirmed' | 'complete' | 'missing'
  fatigue             Int?
  symptoms            String? // null = not recorded; 'none' | 'mild' | 'persistent'
  recoveryConstrained Boolean   @default(false)
  suggestedAction     String?
  suggestedReason     String?
  suggestedNextMin    Int?
  finalDecision       String?
  finalNextMin        Int?
  notes               String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model ActivityStream {
  activityId String  @id
  sampleSec  Int
  data       String // JSON text: ActivityStreamData
  laps       String? // JSON text: Lap[]

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ActivityFile {
  activityId String  @id
  format     String // 'fit' | 'gpx' | 'tcx'
  fileName   String?
  sizeBytes  Int
  sha256     String
  gz         Bytes

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// What stood out on one run (non-state: derived from state, written on a read path and by the
// pipeline after a store, and read by no snapshot, memo or deliverable, so a write must not drop
// the cache it was computed from). `insight.ts` is the only writer. `facts` is JSON text:
// { basis, items: InputFact[] }, template ids and slots and never prose. Stale when `version`
// differs from STANDOUT_VERSION, the activity changed after `computedAt`, or the stored assessment
// of the session it fulfils is no longer the `basis` the facts were computed with.
model ActivityInsight {
  activityId String   @id
  version    Int
  facts      String
  computedAt DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// The Monday brief (phase 3a design 8.3 and 8.5): the facts of one week, as `BriefFacts` JSON, which
// holds template ids, codes and slots and never prose (ADR 0010). Non-state: it is written by the
// weekly job after its re-plan and, for the current week only, by a request that finds none, and
// no snapshot, memo or deliverable reads it. `server/services/brief.ts` is its only writer. It has
// no seen column: a brief is seen when the revision it describes is (`PlanRevision.seenAt`), or when
// it describes none. `revisionId` is unique and set to null when the revision goes with its plan,
// so a brief outlives the revision; `planId` is a plain column for the same reason.
model WeeklyBrief {
  id          String   @id @default(cuid())
  userId      String
  weekStart   String // Monday of the week the brief opens, YYYY-MM-DD
  planId      String? // the active plan when the brief was built; null when there was none
  revisionId  String?  @unique
  version     Int // BRIEF_VERSION when the facts were built
  facts       String // JSON text: BriefFacts
  provisional Boolean  @default(false) // built by a request before the weekly update ran
  generatedAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision PlanRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart])
}

model AthleteProfile {
  userId                String   @id
  birthYear             Int?
  sex                   String? // 'female' | 'male' | 'unspecified'
  heightCm              Float?
  weightKg              Float?
  hrMax                 Int?
  hrMaxSource           String? // 'measured' | 'estimated'
  hrRest                Int?
  lthr                  Int?
  thresholdPaceSecPerKm Int?
  runningSinceYear      Int?
  injuries              String   @default("[]") // JSON text: Injury[]
  availability          String   @default("{}") // JSON text: Availability
  longRunDay            String   @default("sat") // 'mon' .. 'sun'
  terrain               String   @default("{}") // JSON text: Terrain
  strengthPreference    Int      @default(2) // 0-3
  timezone              String   @default("UTC") // IANA
  homeLat               Float?
  homeLng               Float?
  useHomeWeather        Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WellnessDay {
  id            String   @id @default(cuid())
  userId        String
  date          String // YYYY-MM-DD
  restingHr     Int?
  hrvRmssd      Float?
  hrvSdnn       Float?
  sleepSec      Int?
  sleepScore    Int?
  weightKg      Float?
  vo2max        Float?
  notes         String?
  source        String // provider registry key or 'manual'
  updatedAt     DateTime @updatedAt
  fatigue       Int? // check-in, 1-5, 3 = normal
  soreness      Int?
  sleepQuality  Int?
  mood          Int?
  stress        Int?
  illness       Boolean  @default(false)
  painScore     Int? // 0-10
  painArea      String?
  painFocalBone Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Integration {
  id              String    @id @default(cuid())
  userId          String
  provider        String // provider registry key
  status          String // 'connected' | 'needs_auth' | 'error'
  secret          String // encrypted, see server/crypto.ts
  config          String // JSON text, no secrets
  ingestTokenHash String? // SHA-256 of the push token
  cursor          String? // opaque, provider-defined
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastError       String?
  pausedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// One finished run of a pull, push, folder scan or scheduled job (non-state: a log, never read by
// the athlete snapshot). `recordSyncRun` is the only writer and prunes to 200 rows and 90 days.
model SyncRun {
  id             String   @id @default(cuid())
  userId         String
  provider       String // provider registry key, or the job name for channel 'job'
  channel        String // 'pull' | 'push' | 'folder' | 'publish' | 'job'
  trigger        String // 'schedule' | 'manual' | 'push' | 'catchup'
  startedAt      DateTime
  finishedAt     DateTime
  status         String // 'ok' | 'partial' | 'paused' | 'error'
  accepted       Int      @default(0)
  duplicate      Int      @default(0)
  failed         Int      @default(0)
  wellnessStatus String   @default("none") // 'none' | 'read' | 'truncated' | 'waiting' | 'error'
  wellnessDays   Int?
  wellnessTotal  Int?
  message        String? // scrubbed by safeMessage, at most 300 characters
  failures       String   @default("[]") // JSON text: the first 10 { ref, reason }
  importBatchId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, startedAt])
}

// The 7-day hourly forecast of one 0.1 degree home cell (non-state). The weather job fills it and
// no request waits for it; a change key that depends on the forecast uses `forecastStamp`. Cells are
// integer tenths of a degree so that the unique key never compares floats. `fetchedAt` is null until
// a fetch succeeds; a failed fetch keeps the old hours and sets `failedAt` (15-minute back-off).
model ForecastCache {
  id        String    @id @default(cuid())
  latE1     Int
  lngE1     Int
  hours     String    @default("[]") // JSON text: WeatherHour[], GMT
  fetchedAt DateTime?
  failedAt  DateTime?
  lastError String?

  @@unique([latE1, lngE1])
}

// Race-window WBGT climatology of one 0.01 degree race cell, month and day, start hour and window
// length (state: the snapshot's prediction reads it, so a refresh must drop a memoised prediction).
// `wbgtC` is the mean over the last three archive years; `complete` is false while a year could not
// be read, and an incomplete row, or one older than 30 days, is read again with its old value kept.
model ClimateCache {
  id          String    @id @default(cuid())
  latE2       Int
  lngE2       Int
  monthDay    String // 'MM-DD'
  startHour   Int
  windowHours Int
  wbgtC       Float?
  samples     Int       @default(0)
  yearsRead   Int       @default(0)
  complete    Boolean   @default(false)
  fetchedAt   DateTime?
  failedAt    DateTime?
  lastError   String?

  @@unique([latE2, lngE2, monthDay, startHour, windowHours])
}

model ImportedFile {
  id         String   @id @default(cuid())
  userId     String
  sha256     String
  fileName   String?
  channel    String // 'upload' | 'folder' | 'provider' | 'push'
  outcome    String // 'imported' | 'duplicate' | 'no-activity' | 'invalid'
  activityId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sha256])
}

// One row per user and delivery channel (settings, the scheduler's state, the calendar feed's token
// hash). Non-state: a publish run writes it, and a state write would trigger the next run.
model DeliveryChannel {
  id             String    @id @default(cuid())
  userId         String
  channel        String // 'intervals' | 'calendar'
  enabled        Boolean   @default(false)
  garminLinked   Boolean   @default(false) // intervals: the runner ticked the Garmin upload
  dataKey        String? // intervals: the composed change key the last run saw
  lastRunAt      DateTime?
  pausedUntil    DateTime?
  referenceJson  String? // intervals: { maxHr, lthr, thresholdPaceMps, readAt }, 6 h cache
  tokenHash      String?   @unique // calendar: SHA-256 of the feed token; the token is never stored
  tokenCreatedAt DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

// What the remote holds, or should hold, for one session identity. Joined to PlanSession by
// externalId with no foreign key, so a regenerate that carries the identity keeps the row. Non-state.
model WristPublication {
  id            String    @id @default(cuid())
  userId        String
  channel       String // 'intervals'
  externalId    String // PlanSession.externalId
  date          String // YYYY-MM-DD
  kind          String
  variant       String    @default("planned") // 'planned' | 'eased'
  title         String // the allowlisted public title sent
  remoteId      String?
  state         String // 'pending' | 'sent' | 'failed' | 'withdrawn' | 'owner-removed'
  desiredHash   String
  sentHash      String?
  failCode      String?
  failMessage   String? // sanitised, max 200
  deviceMessage String? // sanitised, max 200
  warnings      String    @default("[]") // JSON text: string[]
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, externalId])
  @@index([userId, channel, date])
}

// A gel, drink mix, chew or other thing the runner carries (state, ADR 0011). Archived, never
// deleted, so history stays readable; the name is unique among live products by a service rule,
// because Prisma has no partial unique index.
model FuelProduct {
  id           String   @id @default(cuid())
  userId       String
  name         String
  kind         String // 'gel' | 'drink' | 'chew' | 'bar' | 'food' | 'electrolyte' | 'other'
  servingLabel String // what one serving is, such as "1 gel" or "500 mL bottle"
  carbsG       Float // carbohydrate in one serving
  sodiumMg     Int? // sodium in one serving
  kcal         Int? // energy in one serving
  multiCarb    Boolean  @default(false) // more than one transportable carbohydrate
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived])
}

// One run's fuel log (state: the ladder replay reads it). The totals, the rate, the multi-carb
// share, the hot flag, block credit and every ladder step are derived on each read and never
// stored. `hotOverride` null means the run's current weather decides on every replay, because the
// weather job fills activities in batches and a flag fixed at save time would usually be false.
model FuelLog {
  id          String   @id @default(cuid())
  userId      String
  activityId  String   @unique
  skipped     Boolean  @default(false) // "Not this time": the run does not count
  items       String   @default("[]") // JSON text: FuelLogItem[], a snapshot of each product eaten
  fluidMl     Int?
  sodiumMg    Int? // sodium the runner reports taking, beyond what the products add up to
  gut         Int? // 0-4; null only when skipped
  nausea      Int? // 0-4
  hotOverride Boolean?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The runner's fuel switches (state: they bound the ladder). One row per user, created on the
// first PUT; a missing row means the defaults below.
model FuelSettings {
  userId        String   @id
  optIn90       Boolean  @default(false) // opens the rungs from the first higher tier up to 90 g/h
  optInAdvanced Boolean  @default(false) // opens the rungs above 90 g/h; needs optIn90
  giDisease     Boolean  @default(false) // a diagnosed gut condition: floor only, no gut-training block
  gutBlock      Boolean  @default(true) // the gut-training block before the taper
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A dated rest or limited-running window the runner reported (phase 3a design 9.3, rule J9). State:
// the athlete snapshot, the engine and the publisher read it. A window is engine input, not a set
// of check-ins, and it is written only by a revision (`PlanRevision.disruptionId` names it, with no
// foreign key). `status` 'undone' is a window withdrawn, by its removal or by the undo of the
// revision that created it; the row stays, so a revision keeps pointing at it.
model Disruption {
  id         String   @id @default(cuid())
  userId     String
  reason     String // 'illness-above-neck' | 'illness-below-neck' | 'niggle' | 'short-on-time' | 'travel'
  mode       String // 'rest' | 'limited'
  startDate  String // YYYY-MM-DD; may be in the past
  endDate    String // YYYY-MM-DD, inclusive
  maxRunMin  Int? // 'limited' only
  area       String? // niggle only
  pain       Int? // niggle only, 0-10
  gaitChange Boolean  @default(false) // niggle only
  note       String? // never read by the engine
  status     String   @default("active") // 'active' | 'undone'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endDate])
}

// The runner's equipment and lifting history (strength design 9.3; state: it decides which lifts a
// workout holds). One row per user, created on the first PUT; a missing row means the defaults
// below. `savedAt` stays null until the runner has saved the setup, which is what `setupSaved`
// reads: until then the workout is built for bodyweight only.
model StrengthSettings {
  userId           String    @id
  equipment        String    @default("[]") // JSON text: EquipmentConfig[]
  level            String    @default("new") // 'new' | 'some' | 'experienced'
  currentlyLifting Boolean   @default(false)
  avoid            String    @default("[]") // JSON text: exercise ids left out
  pinned           String    @default("{}") // JSON text: slot ('knee' | 'hip' | 'calf') to exercise id
  note             String? // never read by the engine
  savedAt          DateTime? // null until the runner saves the setup
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A starting point the runner entered for one exercise (state: it sets a first load). One row per
// exercise; a new entry replaces the previous one.
model StrengthLift {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  kind       String // 'set' | 'max'
  loadG      Int
  reps       Int // 1 for a max
  rir        Int? // 0-5
  asOf       String // YYYY-MM-DD
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
}

// One strength session's sets (state: the next suggestion and Today read it). `id` is chosen by the
// client (a UUID), so the save is an idempotent PUT that the outbox may replay. The session's date,
// minutes, effort, pain and note are the fields of the linked `Activity` (type 'strength').
model StrengthLog {
  id         String   @id
  userId     String
  activityId String   @unique
  prescribed String // JSON text: the snapshot of what the sheet showed (strength design 9.3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sets     StrengthSet[]

  @@index([userId])
}

model StrengthSet {
  id         String @id @default(cuid())
  logId      String
  userId     String
  exerciseId String
  position   Int // order within the session
  loadG      Int?
  count      Int // reps, seconds or contacts, by the exercise's measure
  rir        Int? // 0-5

  log  StrengthLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([logId, position])
  @@index([userId, exerciseId])
}
