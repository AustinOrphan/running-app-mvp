# A relative file: DATABASE_URL resolves against the prisma/ directory for both the Prisma CLI
# and the client. Tests, e2e and Docker use absolute paths.
DATABASE_URL=file:./data/app.db

# At least 32 characters; filled by `npm run setup`. Rotating it logs the owner out.
SESSION_SECRET=

PORT=3001
NODE_ENV=development

# Set to true to allow creating a second account after the first.
ALLOW_REGISTRATION=false

# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
